{
  "name": "menu",
  "description": "The browser menu window opens and its entries work.",
  "steps": [
    {
      "do": "evaluate",
      "expression": "window.fdbMenuBar(); return true;",
      "why": "the menu bar is asked for, the way the F10 key does it"
    },
    {
      "do": "pause",
      "ms": 800,
      "why": "the app has a moment to open the menu"
    },
    {
      "do": "targets",
      "expect": {
        "contains": "Menu"
      },
      "timeout": 10000,
      "why": "the menu window opens"
    },
    {
      "do": "inPage",
      "title": "Menu",
      "expression": "return document.querySelectorAll('button[data-id]').length;",
      "expect": {
        "above": 5
      },
      "why": "the menu lists its entries"
    },
    {
      "do": "inPage",
      "title": "Menu",
      "expression": "return Array.from(document.querySelectorAll('button[data-id]')).some(function(b){return b.textContent.trim() === 'New Tab';});",
      "expect": {
        "equals": true
      },
      "why": "the menu has a New Tab entry"
    },
    {
      "do": "inPage",
      "title": "Menu",
      "expression": "const button = Array.from(document.querySelectorAll('button[data-id]')).find(function(b){return b.textContent.trim() === 'New Tab';}); button.click(); return true;",
      "expect": {
        "equals": true
      },
      "why": "the New Tab entry is pressed"
    },
    {
      "do": "waitFor",
      "expression": "document.querySelectorAll('#tabs > *').length",
      "timeout": 5000,
      "why": "the app has a moment to open the tab"
    },
    {
      "do": "evaluate",
      "expression": "return document.querySelectorAll('#tabs > *').length;",
      "expect": {
        "atLeast": 2
      },
      "why": "the menu opened a second tab"
    }
  ],
  "platform": [
    "linux",
    "windows"
  ]
}
