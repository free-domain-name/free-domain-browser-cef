# Build the CEF browser on Linux and smoke-test it under Xvfb.
#
#   docker build -f Dockerfile.linux -t fdb-cef-linux .
#   docker run --rm --shm-size=1g fdb-cef-linux
#
# The build downloads the pinned CEF distribution into /app/cef-binary, so
# the first build needs network access.
#
# The Rust version matters: iroh 1.4.1 needs rustc 1.91 or newer, so an
# older rust image fails before the build starts.
FROM docker.io/library/rust:1.98-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build pkg-config ca-certificates curl python3 \
      libgtk-3-dev libnss3-dev libx11-xcb-dev libxkbcommon-dev libgbm-dev \
      libasound2-dev libatk1.0-dev libcups2-dev libdrm-dev libxrandr-dev \
      libxcomposite-dev libxdamage-dev libxfixes-dev libpango1.0-dev \
      libcairo2-dev libgl1-mesa-dri libglx-mesa0 libegl1 \
      xvfb x11-utils dbus-x11 fonts-liberation imagemagick xdotool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# CEF is downloaded here by the build script (see .cargo/config.toml).
ENV CEF_PATH=/app/cef-binary
# The build is memory hungry: a debug build with full debuginfo needs more
# than the 2 GB a small container VM has, and the compiler gets killed.
ENV CARGO_PROFILE_DEV_DEBUG=0
ENV CARGO_INCREMENTAL=0
ENV CARGO_BUILD_JOBS=2
RUN cargo fetch --locked
# One layer for the whole build: the build tree is tens of gigabytes, and
# removing the intermediates afterwards keeps the image small enough for a
# small build machine.
RUN cargo build -j 2 --bin free-domain-browser-cef --bin free_domain_browser_cef_helper --bin bundle \
    && rm -rf /app/target/debug/deps /app/target/debug/build \
              /app/target/debug/incremental /app/target/debug/.fingerprint
# The downloaded archive is not needed at runtime and is 400 MB.
RUN rm -f /app/cef-binary/*/*.tar.bz2

COPY scripts/smoke-linux.sh /usr/local/bin/smoke-linux.sh
RUN chmod +x /usr/local/bin/smoke-linux.sh

CMD ["/usr/local/bin/smoke-linux.sh"]
